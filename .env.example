# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brewlite?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001

# SePay Payment Gateway Sandbox credentials
SEPAY_ENV="sandbox"
SEPAY_MERCHANT_ID="SP-TEST-YOUR-MERCHANT-ID"
SEPAY_SECRET_KEY="spsk_test_your_secret_key"
SEPAY_IPN_SECRET_KEY="your_ipn_secret_key"

# Frontend URL (for redirect after payment)
FRONTEND_URL="http://localhost:3000"
