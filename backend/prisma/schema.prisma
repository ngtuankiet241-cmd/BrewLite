generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                String                    @id @default(cuid())
  name              String
  price             Decimal                   @db.Decimal(12, 2)
  imageUrl          String?
  categoryId        String                    @default("other")
  category          Category                  @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  recipeIngredients ProductRecipeIngredient[]
}

model Category {
  id        String    @id
  name      String    @unique
  sortOrder Int
  products  Product[]
}

model SizeOption {
  id         String @id
  name       String
  extraPrice Int
  sortOrder  Int
}

model Topping {
  id         String @id
  name       String
  extraPrice Int
  sortOrder  Int
}

model Ingredient {
  id             String                    @id
  name           String
  unit           String
  stock          Decimal                   @default(0) @db.Decimal(14, 3)
  stockVersion   Int                       @default(0)
  productRecipes ProductRecipeIngredient[]
  toppingRecipes ToppingRecipeIngredient[]
}

model ProductRecipeIngredient {
  productId    String
  sizeId       String
  ingredientId String
  quantity     Decimal @db.Decimal(14, 3)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, sizeId, ingredientId])
}

model ToppingRecipeIngredient {
  toppingId    String
  ingredientId String
  quantity     Decimal @db.Decimal(14, 3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([toppingId, ingredientId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  phone               String?              @unique
  passwordHash        String
  loyaltyPoints       Int                  @default(0)
  orders              Order[]
  idempotencyRequests IdempotencyRequest[]
}

model IdempotencyRequest {
  userId      String
  operation   String
  key         String   @db.VarChar(200)
  requestHash String   @db.Char(64)
  response    String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, operation, key])
}

model Order {
  id               String    @id @default(cuid())
  orderCode        String    @unique
  userId           String?
  status           String    @default("PENDING")
  total            Decimal   @db.Decimal(12, 2)
  subtotal         Decimal?  @db.Decimal(12, 2)
  discount         Decimal   @default(0) @db.Decimal(12, 2)
  promotionCode    String?
  pointsRedeemed   Int       @default(0)
  pointsDiscount   Decimal   @default(0) @db.Decimal(12, 2)
  pointsEarned     Int       @default(0)
  pointsAwardedAt  DateTime?
  pointsRefundedAt DateTime?
  createdAt        DateTime  @default(now())

  user     User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  size      String
  qty       Int
  lineTotal Decimal @db.Decimal(12, 2)

  basePrice      Decimal @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal @default(0) @db.Decimal(12, 2)
  sizeExtraPrice Decimal @default(0) @db.Decimal(12, 2)
  toppings       Json    @default("[]")

  snapshot Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id             String  @id @default(cuid())
  orderId        String
  idempotencyKey String  @unique
  amount         Decimal @db.Decimal(12, 2)
  method         String
  status         String  @default("PENDING")

  order Order @relation(fields: [orderId], references: [id])
}

model Promotion {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  discountType String
  value        Int
  minOrder     Int      @default(0)
  maxDiscount  Int?
  usageLimit   Int?
  usedCount    Int      @default(0)
  startsAt     DateTime
  expiresAt    DateTime
  isActive     Boolean  @default(true)
}
