
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String      @id @default(cuid())
  name       String
  price      Decimal     @db.Decimal(12, 2)
  imageUrl   String?
  stock      Int         @default(0)
  stockVersion Int       @default(0)
  orderItems OrderItem[]
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  phone         String? @unique
  passwordHash  String
  loyaltyPoints Int     @default(0)
  orders        Order[]
  idempotencyRequests IdempotencyRequest[]
}

model IdempotencyRequest {
  userId      String
  operation   String
  key         String   @db.VarChar(200)
  requestHash String   @db.Char(64)
  response    String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, operation, key])
}

model Order {
  id            String      @id @default(cuid())
  orderCode     String      @unique
  userId        String?
  status        String      @default("PENDING")
  total         Decimal     @db.Decimal(12, 2)
  subtotal      Decimal?    @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  promotionCode String?
  pointsRedeemed Int         @default(0)
  pointsDiscount Decimal    @default(0) @db.Decimal(12, 2)
  pointsEarned   Int         @default(0)
  pointsAwardedAt DateTime?
  pointsRefundedAt DateTime?
  createdAt     DateTime    @default(now())

  user          User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  size           String
  qty            Int
  lineTotal      Decimal  @db.Decimal(12, 2)

  basePrice      Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  sizeExtraPrice Decimal  @default(0) @db.Decimal(12, 2)
  toppings       Json     @default("[]")

  snapshot       Json?

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id             String  @id @default(cuid())
  orderId        String
  idempotencyKey String  @unique
  amount         Decimal @db.Decimal(12, 2)
  method         String
  status         String  @default("PENDING")

  order          Order   @relation(fields: [orderId], references: [id])
}

model Promotion {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  discountType String
  value        Int
  minOrder     Int      @default(0)
  maxDiscount  Int?
  usageLimit   Int?
  usedCount    Int      @default(0)
  startsAt     DateTime
  expiresAt    DateTime
  isActive     Boolean  @default(true)
}
