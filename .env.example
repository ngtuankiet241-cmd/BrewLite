# Copy this file to backend/.env and replace the placeholder before using it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brewlite?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001

# SePay Payment Gateway Sandbox credentials from the merchant integration page.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID="replace-with-sandbox-merchant-id"
SEPAY_SECRET_KEY="replace-with-sandbox-merchant-secret"
# In SePay IPN settings, select SECRET_KEY and enter this same value.
SEPAY_IPN_SECRET_KEY="replace-with-a-separate-ipn-secret"
FRONTEND_URL="http://localhost:3000"
