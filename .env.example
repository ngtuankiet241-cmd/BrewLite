# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brewlite?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001

# SePay API v2 Sandbox: use the token/account created in Dashboard Test mode.
SEPAY_ENV=sandbox
SEPAY_API_TOKEN="replace-with-test-mode-api-token"
SEPAY_BANK_ACCOUNT_ID="replace-with-test-mode-bank-account-uuid"
# A separate random secret. Configure webhook authentication as API Key with this value.
# URL: https://YOUR-PUBLIC-BACKEND/payments/webhook (forward to backend port 3001).
SEPAY_WEBHOOK_API_KEY="replace-with-a-random-webhook-secret"
FRONTEND_URL="http://localhost:3000"

# Optional: retain only for old Gateway IPNs; new checkout does not use Gateway.
SEPAY_IPN_SECRET_KEY=""

# Browser-accessible backend URL, embedded when building the frontend image.
NEXT_PUBLIC_API_URL="http://localhost:3001"
